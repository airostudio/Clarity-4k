# Supabase — get these from your Supabase project > Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32

# Google OAuth — console.cloud.google.com > Credentials > OAuth 2.0 Client IDs
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# GitHub OAuth — github.com > Settings > Developer settings > OAuth Apps
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# Access control — comma-separated list of emails allowed to sign in.
# Anyone not on this list is denied at login, even with a valid Google/GitHub account.
ALLOWED_EMAILS=someone@example.com,teammate@example.com

# Magic-link email login — any standard SMTP connection string works
# (Resend, Postmark, SendGrid SMTP relay, AWS SES SMTP, Gmail SMTP, etc.)
EMAIL_SERVER=smtp://user:pass@smtp.example.com:587
EMAIL_FROM=Clarity 4K <noreply@yourdomain.com>
